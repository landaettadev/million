# API Configuration
NEXT_PUBLIC_API_BASE=http://localhost:5244
NEXT_PUBLIC_API_BASE_URL=http://localhost:5244/api

# Environment
NEXT_PUBLIC_ENVIRONMENT=development

# Features
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_ERROR_REPORTING=true

# UI Configuration
NEXT_PUBLIC_DEFAULT_PAGE_SIZE=12
NEXT_PUBLIC_MAX_PAGE_SIZE=50

# Image Storage Configuration (Development - using placeholder images)
NEXT_PUBLIC_IMAGE_BASE_URL=https://picsum.photos
NEXT_PUBLIC_USE_PLACEHOLDER_IMAGES=true
