# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:5244
NEXT_PUBLIC_API_BASE_URL=http://localhost:5244/api

# Image Storage Configuration
NEXT_PUBLIC_IMAGE_BASE_URL=https://millionstorageprod.blob.core.windows.net/property-images

# Azure Storage (if using Azure)
NEXT_PUBLIC_AZURE_STORAGE_ACCOUNT=millionstorageprod
NEXT_PUBLIC_AZURE_STORAGE_CONTAINER=property-images

# Development Settings
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_DEBUG_MODE=true

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_DEBUG_LOGGING=true
