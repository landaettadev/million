{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:3001"
    ]
  },
  "MongoDb": {
    "ConnectionString": "mongodb://admin:password123@localhost:27017/realestate?authSource=admin",
    "Database": "realestate",
    "CollectionNames": {
      "Properties": "properties",
      "PropertyImages": "propertyImages",
      "PropertyTraces": "propertyTraces",
      "Owners": "owners",
      "AdminUsers": "adminUsers",
      "RefreshTokens": "refreshTokens",
      "TokenBlacklist": "tokenBlacklist"
    }
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "AzureStorage": {
    "ConnectionString": "UseDevelopmentStorage=true",
    "ContainerName": "property-images",
    "BaseUrl": ""
  },
  "Seed": {
    "Enabled": true,
    "InsertIfEmpty": true,
    "Count": 12
  },
  "Swagger": {
    "Enabled": true
  },
  "JWT": {
    "KEY": "your-super-secret-jwt-key-that-is-at-least-32-characters-long",
    "ISSUER": "millionluxury",
    "AUDIENCE": "millionluxury-admin",
    "EXPIRES_MIN": 60
  }
}
